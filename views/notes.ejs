<div class="notes" style="display: flex;flex-wrap: wrap;gap: 10px;margin-top: 20px;padding-right: 20px;">
  <% for (const e of notes) { %>
  <div
    class="note"
    style="
      padding: 15px;
      border: 1px solid #d3d3d359;
      width: fit-content;
      width: 220px;
      min-height: 230px;
      border-radius: 5px;
    "
  >
    <h3 style="margin-bottom: 10px;display: flex;justify-content: space-between;"><%= e.title %> 
      <form action="/note/<%= e._id %>?_method=DELETE" method="post">
        <button style="background-color: transparent;border: none;">
          <span class="material-symbols-outlined">delete</span>
        </button>
      </form>
    </h3>
    <p><%= e.desc %></p>
  </div>

  <% } %>
</div>
